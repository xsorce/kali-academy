#!/usr/bin/env bash
set -euo pipefail
ROOT="${KALI_ACADEMY_ROOT:-$HOME/.local/share/kali-academy/app}"
case "${1:-list}" in
  list)
    exec bash "$ROOT/bin/academy-model" status
    ;;
  smart)
    exec bash "$ROOT/bin/academy-model" install smart
    ;;
  coder)
    echo "qwen3-coder:30b requires 19 GB disk; allow 24 GB free. RAM: 32 GB minimum."
    read -r -p "Download it? [y/N] " a
    if [[ "$a" =~ ^[Yy]$ ]]; then
      ollama pull qwen3-coder:30b
      [[ "$(ollama list | awk '$1 == "qwen3-coder:30b" {print $2; exit}')" == 06c1097efce0* ]] || {
        echo "qwen3-coder:30b model ID verification failed." >&2; exit 1;
      }
    else
      echo "Cancelled."
    fi
    ;;
  *)
    echo "Usage: academy-models [list|smart|coder] (prefer: academy model ...)"
    exit 1
    ;;
esac
